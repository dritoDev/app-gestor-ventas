DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DB_NAME
PORT=4000
WEB_ORIGIN=http://localhost:3001
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
ADMIN_EMAIL=admin@tienda.local
ADMIN_PASSWORD=REPLACE_WITH_A_SECURE_PASSWORD
NEXT_PUBLIC_APP_NAME=Mercato

# MCP: habilitar con un proveedor OAuth 2.1 (Authorization Code + PKCE S256).
# Keycloak local: `docker compose up -d keycloak` (realm importado desde keycloak/mercato-realm.json).
MCP_PUBLIC_URL=http://localhost:4000/mcp
MCP_OAUTH_ISSUER=http://localhost:8081/realms/mercato
MCP_OAUTH_JWKS_URL=http://localhost:8081/realms/mercato/protocol/openid-connect/certs
MCP_USER_ID_CLAIM=mercato_user_id
MCP_REST_URL=http://127.0.0.1:4000
MCP_ALLOWED_ORIGINS=http://localhost:6274

