# ============================================
# MCP SERVER (Mercato API) - Configuración OAuth
# ============================================
MCP_PUBLIC_URL=http://localhost:4000/mcp
MCP_OAUTH_ISSUER=http://localhost:8081/realms/mercato
MCP_OAUTH_JWKS_URL=http://localhost:8081/realms/mercato/protocol/openid-connect/certs
MCP_USER_ID_CLAIM=mercato_user_id
MCP_REST_URL=http://127.0.0.1:4000
MCP_ALLOWED_ORIGINS=http://localhost:6274,http://localhost:5678

# ============================================
# N8N MCP INTEGRATION
# ============================================
# Token OAuth para que n8n (MCP Client) llame a Mercato MCP Server
# Obtener con: curl -X POST http://localhost:8081/realms/mercato/protocol/openid-connect/token \
#   -d "grant_type=password&client_id=mercato-cli&username=admin&password=miclavesegura2026&scope=mcp:read mcp:write"
MERCATO_MCP_TOKEN=

# URL del servidor MCP de n8n (para que Mercato u otros clientes llamen a n8n)
N8N_MCP_URL=http://localhost:5678/mcp-server/http

