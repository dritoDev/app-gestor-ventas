{
  "mcp": {
    "servers": {
      "everything": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-everything"
        ],
        "environment": {
          "LOG_LEVEL": "info"
        }
      },
      "mercato-api": {
        "type": "remote",
        "url": "http://localhost:4000/mcp"
      }
    }
  }
}
