{
  "mcp": {
    "servers": {
      "everything": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-everything"
        ],
        "environment": {
          "LOG_LEVEL": "info"
        }
      },
      "mercato-api": {
        "type": "remote",
        "url": "http://localhost:4000/mcp",
        "oauth": {
          "client_id": "mercato-mcp",
          "scope": "mcp:read mcp:write",
          "callback_port": 6274,
          "redirect_uri": "http://127.0.0.1:6274/callback"
        }
      }
    }
  }
}